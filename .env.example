# ==============================================================================
# Supabase & Application Environment Configuration
# ==============================================================================

# Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for client-side queries with RLS)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Secret Key (Backend Admin migrations only)
# Keep this secret! Never expose to client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Local API Server Port (Default: 3001)
PORT=3001
